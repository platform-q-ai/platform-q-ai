<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @page.title %> - <%= @site.title %></title>
  <link rel="stylesheet" href="../css/app.css">
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
</head>
<body>
  <%= render_partial("nav.html", assigns) %>
  <div class="container-custom">

    <!-- Post Header -->
    <div class="post-header">
      <div class="label">
        <span><%= if @page.frontmatter["category"], do: @page.frontmatter["category"], else: "Post" %></span>
      </div>
      <h1><%= @page.title %></h1>
      <%= if @page.frontmatter["subtitle"] do %>
        <p class="subtitle"><%= @page.frontmatter["subtitle"] %></p>
      <% end %>
    </div>

    <!-- Post Meta -->
    <div class="post-meta">
      <%= if @page.date do %>
        <span class="date"><%= Calendar.strftime(@page.date, "%d %b %Y") %></span>
      <% end %>
      <%= if @page.frontmatter["category"] do %>
        <span class="category-tag"><%= @page.frontmatter["category"] %></span>
      <% end %>
    </div>

    <!-- Hero Image -->
    <%= if @page.frontmatter["image"] do %>
      <div class="hero-image-container">
        <img src="<%= @page.frontmatter["image"] %>" alt="<%= @page.title %>" class="hero-image">
      </div>
    <% end %>

    <!-- Main Content -->
    <div class="content-body">
      <%= String.replace(@content, "<p>---</p>", "<hr>") %>
    </div>

  </div>
  <script src="../js/app.js"></script>
  <%= render_partial("footer.html", assigns) %>
</body>
</html>
