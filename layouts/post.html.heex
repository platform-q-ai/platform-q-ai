<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= if @page.title in [nil, "", "Platform Q"], do: "Platform Q", else: @page.title <> " - Platform Q" %></title>
  <%= render_partial("head.html", assigns) %>
</head>
<body>
  <%= render_partial("nav.html", assigns) %>
  <%= render_partial("prose.html", assigns) %>
  <%
    fm = @page.frontmatter || %{}
    category = fm["category"]
    tags = if is_list(fm["tags"]), do: fm["tags"], else: []
    image = fm["image"] || ""
    image_src = if String.starts_with?(image, "/"), do: ".." <> image, else: image
    image_alt = fm["image_alt"] || ""
    words = @content |> String.replace(~r/<[^>]*>/, " ") |> String.split(~r/\s+/, trim: true) |> length()
    minutes = max(1, div(words + 219, 220))
  %>
  <main id="main">
    <article class="post">
      <header class="post-header wrap">
        <p class="eyebrow eyebrow-accent">
          <%= if category do %><a href="../categories/<%= category %>.html"><%= category %></a><% else %>Post<% end %>
        </p>
        <h1><%= @page.title %></h1>
        <%= if fm["intro"] do %><p class="lede"><%= fm["intro"] %></p><% end %>
        <p class="post-meta">
          <%= if @page.date do %><time datetime="<%= Calendar.strftime(@page.date, "%Y-%m-%d") %>"><%= Calendar.strftime(@page.date, "%d %B %Y") %></time><span aria-hidden="true">·</span><% end %>
          <span><%= @site.author %></span><span aria-hidden="true">·</span>
          <span><%= minutes %> min read</span>
        </p>
      </header>

      <%= if image_src != "" do %>
        <figure class="post-figure wrap">
          <img src="<%= image_src %>" alt="<%= image_alt %>" width="1200" height="<%= round(fm["image_height"] || 760) %>">
        </figure>
      <% end %>

      <div class="prose wrap">
        <%= prose_html %>
      </div>

      <footer class="post-footer wrap">
        <%= if tags != [] do %>
          <ul class="tag-list" aria-label="Tags">
            <%= for tag <- tags do %><li><a href="../tags/<%= tag %>.html">#<%= tag %></a></li><% end %>
          </ul>
        <% end %>
        <a class="section-link" href="../posts/index.html"><span aria-hidden="true">←</span> All posts</a>
      </footer>
    </article>
  </main>
  <%= render_partial("footer.html", assigns) %>
</body>
</html>
