<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @page.title %> - <%= @site.title %></title>
  <%= render_partial("head.html", assigns) %>
</head>
<body>
  <%= render_partial("nav.html", assigns) %>
  <%= render_partial("prose.html", assigns) %>
  <% fm = @page.frontmatter || %{} %>
  <main id="main">
    <article class="page">
      <header class="post-header wrap">
        <p class="eyebrow eyebrow-accent">Platform Q</p>
        <h1><%= @page.title %></h1>
        <%= if fm["subtitle"] do %><p class="lede"><%= fm["subtitle"] %></p><% end %>
      </header>
      <div class="prose wrap<%= if fm["lead"] == true, do: " prose-lead" %>">
        <%= prose_html %>
      </div>
    </article>
  </main>
  <%= render_partial("footer.html", assigns) %>
</body>
</html>
