<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @page.title %> - <%= @site.title %></title>
  <link rel="stylesheet" href="../css/app.css">
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
</head>
<body>
  <%= render_partial("nav.html", assigns) %>
  <div class="container-custom">

    <!-- Header Section -->
    <div class="header-grid<%= if !@page.frontmatter["intro"], do: " header-grid-full" %>">
      <div class="title-col">
        <h1><%= @page.title %></h1>
        <div class="category-wrapper">
          <div class="category-line"></div>
          <span class="category">Page</span>
        </div>
      </div>
      <%= if @page.frontmatter["intro"] do %>
        <div class="intro-col">
          <p class="header-intro"><%= @page.frontmatter["intro"] %></p>
        </div>
      <% end %>
    </div>

    <!-- Hero Image -->
    <%= if @page.frontmatter["image"] do %>
      <div class="hero-image-container">
        <img src="<%= @page.frontmatter["image"] %>" alt="<%= @page.title %>" class="hero-image">
      </div>
    <% end %>

    <!-- Post Details -->
    <%= if @page.frontmatter["subtitle"] do %>
      <div class="post-details">
        <h3><%= @page.frontmatter["subtitle"] %></h3>
      </div>
    <% end %>

    <!-- Main Content -->
    <div class="content-body">
      <%= String.replace(@content, "<p>---</p>", "<hr>") %>
    </div>

  </div>
  <script src="../js/app.js"></script>
  <%= render_partial("footer.html", assigns) %>
</body>
</html>
