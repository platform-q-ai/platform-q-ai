<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @page.title %> - <%= @site.title %></title>
  <%= render_partial("head_fonts.html", assigns) %>
  <link rel="stylesheet" href="./css/app.css">
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
</head>
<body>
  <%= render_partial("nav.html", assigns) %>

  <div class="container-custom">

    <!-- Research Banner -->
    <section class="research-banner">
      <div class="research-banner-inner">
        <div class="research-banner-content">
          <p class="research-label">Research · Fail or Die Index™</p>
          <h2 class="research-headline">When software creation costs got to zero, <em>which SaaS companies survive?</em></h2>
          <p class="research-description">
            A proprietary score from 0–100 mapping existential risk in the agentic era.
            50 companies tracked across moat strength, AI exposure, threat velocity, and adaptation rate.
          </p>
          <a href="https://failordie.com" target="_blank" rel="noopener noreferrer" class="research-cta">
            Explore the live index →
          </a>
        </div>
        <div class="research-banner-stats">
          <div class="research-stat">
            <span class="research-stat-value">50</span>
            <span class="research-stat-label">Companies tracked</span>
          </div>
          <div class="research-stat">
            <span class="research-stat-value">0–100</span>
            <span class="research-stat-label">FoD Score range</span>
          </div>
          <div class="research-stat">
            <span class="research-stat-value">5</span>
            <span class="research-stat-label">Risk dimensions</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Home Header -->
    <div class="home-header">
      <p class="label">Platform Q · Artificial Intelligence</p>
      <h1>
        When agents build the software,<br>
        <em>what's left to write about?</em>
      </h1>
      <p class="tagline">
        Strategic analysis, architecture deep-dives, and original research for the agentic era.
      </p>
    </div>

    <%
      posts_collection = Map.get(@collections, "posts")
      posts = if posts_collection, do: posts_collection.pages, else: []
      sorted_posts = Enum.sort_by(posts, &(&1.date), {:desc, Date})
      {hero_list, rest} = Enum.split(sorted_posts, 1)
      hero = List.first(hero_list)
      {sidebar_posts, rest} = Enum.split(rest, 3)
      {grid_posts, _} = Enum.split(rest, 4)
    %>

    <%
      show_sidebar = length(sorted_posts) > 1
      section_class = if show_sidebar, do: "featured-section", else: "featured-section single-post"
      hero_class = if show_sidebar, do: "hero-post", else: "hero-post hero-post-full"
    %>
    <section class="<%= section_class %>">
      <!-- Left: Hero -->
      <div class="<%= hero_class %>">
        <%= if hero do %>
          <%
            safe_image = fn img ->
              img = img || ""
              if String.match?(img, ~r/^https?:\/\//) or String.match?(img, ~r/^\//) or String.match?(img, ~r/^\.\.?\//), do: String.replace(img, ~r/['"\\();\n\r]/, ""), else: ""
            end
            image = safe_image.(hero.frontmatter["image"]) || "https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1200&q=80"
            date = if hero.date, do: Calendar.strftime(hero.date, "%B %d, %Y"), else: ""
            url = String.trim_leading(hero.url || "", "/")
            intro = hero.frontmatter["intro"] || hero.frontmatter["description"] || "Check out this latest post from our team."
          %>
          <div class="hero-image" style="background-image: url('<%= image %>')"></div>
          <div class="hero-content">
            <h2><a href="<%= url %>"><%= hero.title %></a></h2>
            <p><%= intro %></p>
            <div class="meta">
              <span class="date"><%= date %></span>
            </div>
          </div>
        <% else %>
          <div class="hero-content">
            <h2>No posts found.</h2>
            <p>Please add some posts to the content/posts directory.</p>
          </div>
        <% end %>
      </div>

      <%= if show_sidebar do %>
      <!-- Right: Sidebar -->
      <div class="sidebar-posts">
        <h3>Latest</h3>
        <div class="divider"></div>
        <%= for post <- sidebar_posts do %>
          <%
            date = if post.date, do: Calendar.strftime(post.date, "%B %d, %Y"), else: ""
            url = String.trim_leading(post.url || "", "/")
            intro = post.frontmatter["intro"] || post.frontmatter["description"] || ""
          %>
          <div class="sidebar-post-item">
            <h4><a href="<%= url %>"><%= post.title %></a></h4>
            <%= if intro != "" do %>
              <p class="sidebar-intro"><%= intro %></p>
            <% end %>
            <div class="meta">
              <span class="date"><%= date %></span>
            </div>
          </div>
        <% end %>
      </div>
      <% end %>
    </section>

    <!-- Bottom: Grid -->
    <section class="posts-grid">
      <%= for post <- grid_posts do %>
        <%
          safe_image = fn img ->
            img = img || ""
            if String.match?(img, ~r/^https?:\/\//) or String.match?(img, ~r/^\//) or String.match?(img, ~r/^\.\.?\//), do: String.replace(img, ~r/['"\\();\n\r]/, ""), else: ""
          end
          image = safe_image.(post.frontmatter["image"]) || "https://images.unsplash.com/photo-1499750310159-5254f4197283?auto=format&fit=crop&w=600&q=80"
          date = if post.date, do: Calendar.strftime(post.date, "%B %d, %Y"), else: ""
          url = String.trim_leading(post.url || "", "/")
          intro = post.frontmatter["intro"] || post.frontmatter["description"] || "Read more about this topic..."
        %>
        <div class="grid-post-card">
          <div class="card-image" style="background-image: url('<%= image %>')"></div>
          <div class="card-content">
            <h4><a href="<%= url %>"><%= post.title %></a></h4>
            <p><%= intro %></p>
            <div class="meta">
              <span class="date"><%= date %></span>
            </div>
          </div>
        </div>
      <% end %>
    </section>

  </div>
  <script src="./js/app.js"></script>
  <%= render_partial("footer.html", assigns) %>
</body>
</html>
