<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= if @page.title in [nil, "", "Platform Q"], do: "Platform Q", else: @page.title <> " - Platform Q" %></title>
  <%= render_partial("head.html", assigns) %>
</head>
<body>
  <%= render_partial("nav.html", assigns) %>
  <% fm = if is_map(@page) and is_map(Map.get(@page, :frontmatter)), do: @page.frontmatter, else: %{} %>
  <main id="main">
    <header class="post-header wrap">
      <p class="eyebrow eyebrow-accent">Writing</p>
      <h1><%= @page.title %></h1>
      <%= if fm["description"] do %><p class="lede"><%= fm["description"] %></p><% end %>
    </header>
    <div class="collection wrap">
      <%= (@content || "") |> String.replace(~s(<h3 class="post-title">), ~s(<h2 class="post-title">)) |> String.replace(~r{(<h2 class="post-title">.*?)</h3>}s, "\\1</h2>") %>
    </div>
  </main>
  <%= render_partial("footer.html", assigns) %>
</body>
</html>
